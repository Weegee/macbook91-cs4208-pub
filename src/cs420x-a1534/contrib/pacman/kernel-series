#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# kernel-series - which Linux kernel series the macbook91-cs4208 driver is
# built for, and what to do on any other.
#
# One list decides it: kheaders/KERNEL-SERIES in the DKMS source tree, which
# packaging/fetch-upstream.sh writes from packaging/upstream.lock. Outside the
# module's own Makefile this script is its only reader. The root Makefile's
# install target writes dkms.conf's BUILD_EXCLUSIVE_KERNEL from --dkms-regex,
# the pacman hook calls --hook and macbook91-audio-verify calls --kernel, so
# what DKMS builds, what the hook warns about and what the verifier fails on
# cannot disagree.
#
# A kernel belongs to series X.Y when its release starts with "X.Y.", which is
# exactly what BUILD_EXCLUSIVE_KERNEL="^(X\.Y|...)\." tests.
#
#   kernel-series --list              the shipped series, space-separated
#   kernel-series --kernel RELEASE    exit 0 if RELEASE is of a shipped series,
#                                     1 if not; a sentence on stdout either way
#   kernel-series --hook              a WARNING block for every installed kernel
#                                     of another series (the pacman hook)
#   kernel-series --dkms-regex        the BUILD_EXCLUSIVE_KERNEL value
#
#   --series-file FILE   the list to read (default: the installed source tree)
#   --modules-root DIR   where --hook looks for kernels (default /usr/lib/modules)
#
# Exit 2: bad arguments, or no readable list.
#
# Text interface (house text HIG). Named deviations, kept on purpose:
#   Abweichung von FEH-2, TYP-1: --hook writes pacman hook output, which
#     follows the makepkg convention "==> WARNING:" on stdout. The test suite
#     pins that header.
#   Abweichung von KAN-3: --kernel exits 1 for "not supported", like grep:
#     0 yes, 1 no, 2 error.
set -u

SERIES_FILE=/usr/src/macbook91-cs4208-@PKGVER@/kheaders/KERNEL-SERIES
MODULES_ROOT=/usr/lib/modules
MODE=''
REL=''
PROG=kernel-series
PKGVER='@PKGVER@'
DOCS_URL=https://github.com/Weegee/macbook91-cs4208-pub

die() { printf '%s: error: %s\n' "$PROG" "$*" >&2; exit 2; }
usage_error() { printf '%s: error: %s\nHelp: %s --help\n' "$PROG" "$*" "$PROG" >&2; exit 2; }

usage() {
	cat <<USAGE
Usage: $PROG MODE [OPTIONS]

Tells which Linux kernel series macbook91-cs4208 builds its speaker driver for.

Examples:
  $PROG --list                  the shipped series
  $PROG --kernel \$(uname -r)    is the running kernel supported

Modes:
  --list              print the shipped series, separated by spaces
  --kernel RELEASE    print a sentence; exit 0 if RELEASE is supported, 1 if not
  --hook              print a warning for every installed kernel of another
                      series (what the pacman hook runs)
  --dkms-regex        print the BUILD_EXCLUSIVE_KERNEL value for dkms.conf

Options:
  --series-file FILE   the list to read (default: the installed source tree)
  --modules-root DIR   where --hook looks for kernels (default /usr/lib/modules)
  -h, --help           show this help
  -V, --version        show the version

Exit status:
  0  yes, or done
  1  --kernel: RELEASE is not supported
  2  usage error, or no readable list

Docs and bug reports: $DOCS_URL
USAGE
}

# usage and version may be asked for anywhere on the line (HIL-1).
for a in "$@"; do
	case "$a" in
		-h|--help) usage; exit 0 ;;
		-V|--version)
			case $PKGVER in @*) PKGVER=unknown ;; esac
			printf '%s (macbook91-cs4208-dkms) %s\n' "$PROG" "$PKGVER"
			exit 0 ;;
	esac
done

while [ $# -gt 0 ]; do
	case "$1" in
		--list|--hook|--dkms-regex) MODE=${1#--}; shift ;;
		--kernel)
			[ $# -ge 2 ] || usage_error "--kernel needs a kernel release"
			MODE=kernel; REL=$2; shift 2 ;;
		--series-file)
			[ $# -ge 2 ] || usage_error "--series-file needs a file"
			SERIES_FILE=$2; shift 2 ;;
		--modules-root)
			[ $# -ge 2 ] || usage_error "--modules-root needs a directory"
			MODULES_ROOT=$2; shift 2 ;;
		-*) usage_error "unknown option '$1'" ;;
		*) usage_error "unexpected argument '$1'" ;;
	esac
done
[ -n "$MODE" ] || usage_error "no mode given; use --list, --kernel RELEASE, --hook or --dkms-regex"

[ -r "$SERIES_FILE" ] || die "cannot read the list of shipped series, $SERIES_FILE"
SERIES=()
while read -r s; do
	[ -n "$s" ] || continue
	[[ $s =~ ^[0-9]+\.[0-9]+$ ]] || die "malformed series '$s' in $SERIES_FILE"
	SERIES+=("$s")
done < "$SERIES_FILE"
[ "${#SERIES[@]}" -gt 0 ] || die "$SERIES_FILE lists no series"

shipped() {  # RELEASE -> exit 0 when it belongs to a shipped series
	local s
	for s in "${SERIES[@]}"; do
		case "$1" in "$s".*) return 0 ;; esac
	done
	return 1
}

series_of() {  # RELEASE -> its X.Y, or nothing
	[[ $1 =~ ^([0-9]+\.[0-9]+)\. ]] && printf '%s' "${BASH_REMATCH[1]}"
}

unsupported() {  # RELEASE -> the explanation, the same for hook and verifier
	local ks
	ks=$(series_of "$1")
	printf 'kernel %s (Linux %s) is not a kernel series macbook91-cs4208 supports.\n' \
		"$1" "${ks:-of unknown series}"
	printf 'No speaker driver is built for it: it runs the stock codec driver, so the\n'
	printf 'internal speakers stay silent there. Supported series: %s.\n' "${SERIES[*]}"
	printf 'Boot the LTS kernel (linux-cachyos-lts) for audio, and update\n'
	printf 'macbook91-cs4208-dkms once it supports Linux %s.\n' "${ks:-this series}"
}

case "$MODE" in
	list)
		printf '%s\n' "${SERIES[*]}"
		;;
	dkms-regex)
		re=''
		for s in "${SERIES[@]}"; do re+="${re:+|}${s//./\\.}"; done
		printf '^(%s)\\.\n' "$re"
		;;
	kernel)
		if shipped "$REL"; then
			printf 'kernel %s is of Linux %s, a supported series (%s)\n' \
				"$REL" "$(series_of "$REL")" "${SERIES[*]}"
			exit 0
		fi
		unsupported "$REL"
		exit 1
		;;
	hook)
		for d in "$MODULES_ROOT"/*/; do
			[ -e "$d/vmlinuz" ] || continue
			rel=$(basename "$d")
			shipped "$rel" && continue
			printf '\n==> WARNING: macbook91-cs4208\n'
			unsupported "$rel" | sed 's/^/    /'
		done
		;;
esac
exit 0
