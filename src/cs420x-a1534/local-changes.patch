+/* --- MacBook9,1 (A1534) additions: begin ---
+ *
+ * A1534 behaviour is reached by branching inside this single, static ops
+ * table on the per-codec spec->is_a1534 flag.
+ *
+ * The bundled snapshot instead assigned hda_codec_to_driver(codec)->ops from
+ * probe (docs/AUDIT-BUNDLED-DRIVER.md F2). That pointer resolves to the
+ * module-global cs420x_driver, so it replaced the ops of every codec bound to
+ * the module and broke re-probe. Dispatching here keeps the table const and
+ * shared while the behaviour stays strictly per codec.
+ */
+static int cs_build_pcms(struct hda_codec *codec)
+{
+	struct cs_spec *spec = codec->spec;
+
+	if (spec->is_a1534)
+		return a1534_build_pcms(codec);
+	return snd_hda_gen_build_pcms(codec);
+}
+
+static int cs_init_dispatch(struct hda_codec *codec)
+{
+	struct cs_spec *spec = codec->spec;
+
+	if (spec->is_a1534)
+		return a1534_init(codec);
+	return cs_init(codec);
+}
+
+/* Mirrors the core's own default for the non-A1534 case: when ops->resume is
+ * NULL the core does snd_hda_codec_init() + snd_hda_regmap_sync().
+ *
+ * snd_hda_codec_init() does nothing besides ops->init() - it calls
+ * driver->ops->init(codec) if set and otherwise returns 0
+ * (sound/hda/common/hda_local.h:656-663, linux 7.2.4). a1534_resume() calls
+ * a1534_init(), the ops->init equivalent,
+ * directly, so skipping snd_hda_codec_init() here skips nothing - deliberate,
+ * not an asymmetry.
+ */
+/* Mark the A1534 configuration as lost. The core calls this before putting the
+ * codec into D3, and everything it does afterwards is unchanged - ops->suspend
+ * is additive, not a replacement. */
+static int cs_suspend(struct hda_codec *codec)
+{
+	struct cs_spec *spec = codec->spec;
+
+	if (spec->is_a1534)
+		spec->a1534.bringup_valid = 0;
+	return 0;
+}
+
+static int cs_resume(struct hda_codec *codec)
+{
+	struct cs_spec *spec = codec->spec;
+
+	if (spec->is_a1534)
+		return a1534_resume(codec);
+
+	snd_hda_codec_init(codec);
+	snd_hda_regmap_sync(codec);
+	return 0;
+}
+/* --- MacBook9,1 (A1534) additions: end --- */
