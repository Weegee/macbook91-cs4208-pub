"""SUPERSEDED - use macbook91-runner probe. Kept as evidence of what was run;
nothing new should be added here.

Does the amplifier I2C bus answer when the DFET supply FETs are driven?

Needs root (CAP_SYS_RAWIO for the HDA verb ioctl).

GPIO 4 (CHDFETControl) and 5 (USDFETControl) gate the TAS5758L supply, per
AppleHDA layouts 121/127/129. They currently read low. The sequence in the
vendored upstream header drives them high (GPIO data 0x20, 0x30, 0x10); this
probe asks whether the bus answers in that state.

It restores the original GPIO data before exiting, plays no audio, and writes
no amplifier register - every amp access here is a READ.
"""
import fcntl, struct, sys, time

HWDEP = '/dev/snd/hwC0D0'
IOCTL = 0xC0084811
VN = 0x24
SET_COEF_INDEX, GET_PROC_COEF, SET_PROC_COEF = 0x500, 0x0c00, 0x400
GET_GPIO_DATA, SET_GPIO_DATA = 0xf15, 0x715
C_EN, C_ADDR, C_DATA, C_CTRL, C_STAT = 0x00, 0x14, 0x15, 0x16, 0x17
START, STOP, ENB = 0x04, 0x02, 0x08

fd = open(HWDEP, 'rb+', buffering=0)

def verb(nid, v, p):
    out = fcntl.ioctl(fd, IOCTL, struct.pack('II', ((nid&0xff)<<24)|((v&0xffff)<<8)|(p&0xff), 0))
    return struct.unpack('II', out)[1]

def cget(i):
    verb(VN, SET_COEF_INDEX, i); return verb(VN, GET_PROC_COEF, 0) & 0xffff

def cset(i, v):
    verb(VN, SET_COEF_INDEX, i); verb(VN, SET_PROC_COEF | ((v>>8)&0xff), v & 0xff)

def bridge(on):
    v = cget(C_EN)
    cset(C_EN, v ^ ENB)
    if on:
        cset(C_EN, (v ^ ENB) | ENB)

def amp_read(addr, reg):
    """One I2C read transaction. Returns (data, data_reg_before_read_phase)."""
    cset(C_ADDR, addr << 1)
    cset(C_CTRL, START); cget(C_STAT)
    cset(C_DATA, reg);   cget(C_STAT)
    mid = cget(C_DATA)                 # did the engine consume what we wrote?
    cset(C_ADDR, (addr << 1) | 1)
    cset(C_CTRL, START); cget(C_STAT)
    data = cget(C_DATA)
    cset(C_CTRL, STOP);  cget(C_STAT)
    return data, mid

def sweep(label):
    print(f"  {label}")
    for addr in (0x6c, 0x6d, 0x6e, 0x6f, 0x20):     # 0x20 = address with nothing on it
        tag = "control" if addr == 0x20 else "amp"
        vals = []
        for reg in (0x01, 0x02, 0x03):
            d, mid = amp_read(addr, reg)
            vals.append(f"r{reg:02x}={d:04x}(mid {mid:04x})")
        print(f"    {tag} 0x{addr:02x}: " + "  ".join(vals))

gpio0 = verb(0x01, GET_GPIO_DATA, 0)
print(f"GPIO data as found : 0x{gpio0:02x}   (bit4 CHDFET={bool(gpio0&0x10)}, bit5 USDFET={bool(gpio0&0x20)})")
print(f"pin 0x1d           : 0x{verb(0x1d,0xf1c,0):08x}")
print()

try:
    bridge(True)
    print("A. DFETs as found")
    sweep("")
    print()

    for data, name in ((gpio0 | 0x30, "both DFETs high (0x30)"),
                       (gpio0 | 0x10, "CHDFET high only (0x10)"),
                       (gpio0 | 0x20, "USDFET high only (0x20)")):
        verb(0x01, SET_GPIO_DATA, data)
        time.sleep(0.05)
        print(f"B. {name} -> GPIO data 0x{verb(0x01, GET_GPIO_DATA, 0):02x}")
        sweep("")
        print()
finally:
    verb(0x01, SET_GPIO_DATA, gpio0)
    bridge(False)
    print(f"restored GPIO data to 0x{verb(0x01, GET_GPIO_DATA, 0):02x}; bridge closed.")
    print()
    print("Reading the same value from address 0x20, where nothing lives, as from")
    print("0x6c-0x6f means the bus is not distinguishing a present device from an")
    print("absent one - so nothing is answering, whatever the DFETs are doing.")
