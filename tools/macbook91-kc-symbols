#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
import os, struct, sys, subprocess

PROG = 'macbook91-kc-symbols'
HELP = '''\
Usage: macbook91-kc-symbols KERNELCACHE KEXT [PATTERN...]

List the symbols of one kext inside a macOS kernel collection, with their
addresses, estimated sizes and demangled names. Read-only. Without PATTERN
nothing is listed. Needs c++filt.

Examples:
  macbook91-kc-symbols BootKernelExtensions.kc com.apple.driver.AppleHDA Cirrus

Options:
  -h, --help     show this help and exit
  -V, --version  show the version and exit

Exit status:
  0  done
  1  the file could not be read or the kext is not in it
  2  usage error
''' + '\nDocs and bug reports: https://github.com/Weegee/macbook91-cs4208-pub\n'

def cli(prog, help_text, minimum):
    """-h/--help and -V/--version win anywhere; too few arguments exit 2."""
    args = sys.argv[1:]
    if any(a in ('-h', '--help') for a in args):
        print(help_text, end='')
        sys.exit(0)
    if any(a in ('-V', '--version') for a in args):
        here = os.path.dirname(os.path.abspath(__file__))
        try:
            with open(os.path.join(here, '..', 'VERSION')) as f:
                ver = f.read().strip()
        except OSError:
            ver = 'unknown'
        print('%s (macbook91-cs4208-dkms) %s' % (prog, ver))
        sys.exit(0)
    if len(args) < minimum:
        print('%s: error: %s\nHelp: %s --help'
              % (prog, 'no arguments given' if not args else 'too few arguments',
                 prog), file=sys.stderr)
        sys.exit(2)


cli(PROG, HELP, 2)
kc = sys.argv[1]; want = sys.argv[2]
try:
    buf = open(kc,'rb').read()
except OSError as e:
    sys.exit('%s: error: cannot read %s: %s' % (PROG, kc, e.strerror))
LC_FILESET_ENTRY=0x80000035; LC_SYMTAB=0x02; LC_SEGMENT_64=0x19
def cmds(off):
    ncmds = struct.unpack_from('<I', buf, off+16)[0]
    p=off+32; out=[]
    for _ in range(ncmds):
        c,s = struct.unpack_from('<II', buf, p); out.append((c,s,p)); p+=s
    return out
ent=None
for c,s,p in cmds(0):
    if c==LC_FILESET_ENTRY:
        vmaddr,fileoff,noff,_=struct.unpack_from('<QQII',buf,p+8)
        name=buf[p+noff:buf.index(b'\0',p+noff)].decode()
        if name==want: ent=(vmaddr,fileoff)
if ent is None:
    sys.exit('%s: error: kext not found in collection: %s' % (PROG, want))
vmaddr,fileoff=ent
symoff=nsyms=stroff=None
for c,s,p in cmds(fileoff):
    if c==LC_SYMTAB:
        symoff,nsyms,stroff,strsize=struct.unpack_from('<IIII',buf,p+8)
syms=[]
for i in range(nsyms):
    o=symoff+i*16
    strx,ntype,nsect,ndesc,nvalue=struct.unpack_from('<IBBHQ',buf,o)
    nm=buf[stroff+strx:buf.index(b'\0',stroff+strx)].decode(errors='replace')
    syms.append((nvalue,nm))
syms.sort()
sel=[(a,n) for a,n in syms if any(k in n for k in sys.argv[3:])]
for a,n in sel:
    # find next symbol address for size
    nxt=next((x for x,_ in syms if x>a), a)
    d=subprocess.run(['c++filt',n],capture_output=True,text=True).stdout.strip()
    print(f'0x{a:x}  size~{nxt-a:<6} {d}')
