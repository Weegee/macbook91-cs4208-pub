"""Request an official Apple recovery image for one board id.

Reimplements the osrecovery protocol rather than executing a downloaded
script: nothing fetched from the network is ever run. Talks to
osrecovery.apple.com only.
"""
import os, random, string, sys
from urllib.request import Request, urlopen
from urllib.parse import urlparse

BOARD = 'Mac-9AE82516C7C6B903'          # MacBook9,1, read from this machine's DMI
MLB_ZERO = '00000000000000000'
UA = 'InternetRecovery/1.0'
USAGE = '''usage: macbook91-fetch-macos-recovery info [latest|default]
       macbook91-fetch-macos-recovery download [latest|default] [OUTDIR]'''


def rid(n):
    return ''.join(random.choices(string.hexdigits[:16].upper(), k=n))


def query(url, headers, post=None, raw=False):
    data = '\n'.join(f'{k}={v}' for k, v in post.items()).encode() if post else None
    r = urlopen(Request(url=url, headers=headers, data=data))
    return r if raw else (dict(r.info()), r.read())


def session():
    h = {'Host': 'osrecovery.apple.com', 'Connection': 'close', 'User-Agent': UA}
    info, _ = query('http://osrecovery.apple.com/', h)
    for k, v in info.items():
        if k.lower() == 'set-cookie':
            for c in v.split('; '):
                if c.startswith('session='):
                    return c
    raise RuntimeError('no session cookie')


def image_info(sess, os_type):
    h = {'Host': 'osrecovery.apple.com', 'Connection': 'close', 'User-Agent': UA,
         'Cookie': sess, 'Content-Type': 'text/plain'}
    post = {'cid': rid(16), 'sn': MLB_ZERO, 'bid': BOARD,
            'k': rid(64), 'fg': rid(64), 'os': os_type}
    _, out = query('http://osrecovery.apple.com/InstallationPayload/RecoveryImage', h, post)
    info = {}
    for line in out.decode().split('\n'):
        if ': ' in line:
            k, v = line.split(': ', 1)
            info[k] = v
    return info


def save(url, token, directory, filename=''):
    p = urlparse(url)
    h = {'Host': p.hostname, 'Connection': 'close', 'User-Agent': UA,
         'Cookie': 'AssetToken=' + token}
    os.makedirs(directory, exist_ok=True)
    filename = filename or os.path.basename(p.path)
    dest = os.path.join(directory, filename)
    r = query(url, h, raw=True)
    total = int(dict(r.headers).get('Content-Length', -1))
    done = 0
    with open(dest, 'wb') as fh:
        while True:
            chunk = r.read(2 ** 20)
            if not chunk:
                break
            fh.write(chunk)
            done += len(chunk)
            if total > 0 and done % (32 * 2 ** 20) < 2 ** 20:
                print(f'  {done/2**20:.0f}/{total/2**20:.0f} MB', flush=True)
    if total > 0 and done != total:
        raise SystemExit(f'truncated download: {done} of {total} bytes in {dest}')
    print(f'  saved {dest} ({done/2**20:.1f} MB)')
    return dest


if __name__ == '__main__':
    mode = sys.argv[1] if len(sys.argv) > 1 else ''
    if mode not in ('info', 'download'):
        # Nothing reaches the network unless the mode is spelled out.
        print(USAGE, file=sys.stderr)
        sys.exit(0 if mode in ('-h', '--help') else 2)
    os_type = sys.argv[2] if len(sys.argv) > 2 else 'latest'
    outdir = sys.argv[3] if len(sys.argv) > 3 else '.'
    s = session()
    info = image_info(s, os_type)
    print(f'board   {BOARD}')
    print(f'os      {os_type}')
    for k in ('AP', 'AU', 'AH', 'CU', 'CH'):
        if k in info:
            print(f'{k:7} {info[k][:120]}')
    if mode == 'download':
        print('downloading image...')
        save(info['AU'], info['AT'], outdir, 'BaseSystem.dmg')
        print('downloading chunklist...')
        save(info['CU'], info['CT'], outdir, 'BaseSystem.chunklist')
